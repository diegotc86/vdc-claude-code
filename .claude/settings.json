{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git worktree *)",
      "mcp__ticketflow-db__list_tables",
      "mcp__ticketflow-db__describe_table",
      "mcp__ticketflow-db__query"
    ],
    "ask": [
      "Bash(npm run db:migrate*)",
      "Bash(npm run db:seed*)",
      "Bash(npm install*)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./server/.env)",
      "Read(./**/.env)",
      "Edit(./server/src/legacy/**)",
      "Write(./server/src/legacy/**)",
      "Bash(git push --force*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-paths.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-change.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-done.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
